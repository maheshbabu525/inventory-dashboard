# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/battery_inventory
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/battery_inventory

# JWT Configuration
JWT_SECRET=battery-dashboard-secret-key-min-32-chars-long-change-in-production

# Server Configuration
