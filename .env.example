# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Python Service
PYTHON_SERVICE_URL=http://localhost:5000
BACKEND_URL=http://localhost:8080

# Flask Configuration
FLASK_ENV=development
